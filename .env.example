# Optional database. Leave unset to use built-in sample events.
# DATABASE_URL="mysql://user:password@localhost:3306/carolinian_events_db"
# DATABASE_URL="postgresql://postgres.PROJECT_REF:password@db.PROJECT_REF.supabase.co:5432/postgres"

# Auth.js / NextAuth. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# Optional organizer signup gate.
ORGANIZER_SECRET="replace-with-an-organizer-invite-secret"

# Optional GitHub login. Create an OAuth app at:
# https://github.com/settings/developers
AUTH_GITHUB_ID="your_github_client_id"
AUTH_GITHUB_SECRET="your_github_client_secret"

# Optional Google OAuth login. Create an OAuth 2.0 Client ID in Google Cloud.
# Callback URL: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your_google_client_id"
AUTH_GOOGLE_SECRET="your_google_client_secret"

# Email verification SMTP. Gmail app passwords, school SMTP, or any SMTP provider work.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your_smtp_username"
SMTP_PASSWORD="your_smtp_password"
SMTP_FROM="Carolinian Events <no-reply@example.com>"

# Supabase Storage for event images.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"
SUPABASE_SECRET_KEY="sb_secret_your_key"
SUPABASE_STORAGE_BUCKET="event-images"
